{
  "manifest_version": "1",
  "round": "14",
  "status": "DRAFTED",
  "description": "Schema manifest for Release 1B. Lists required PocketBase collections, their key fields, and access rules as understood from prior review. Operators must validate this manifest against the actual migration JS files before --run.",
  "collections": {
    "users": {
      "type": "auth",
      "description": "Application users with role-based access",
      "key_fields": {
        "role": {
          "type": "select",
          "values": ["user", "admin", "superadmin"],
          "max_select": 1,
          "required": true,
          "default": "user"
        },
        "name": {
          "type": "text"
        },
        "language": {
          "type": "text"
        },
        "phone_verified": {
          "type": "bool",
          "note": "Historical flag for legacy users; set server-side only"
        },
        "is_alias_account": {
          "type": "bool",
          "note": "Alias accounts must return 400 on auth (same as wrong-password)"
        },
        "avatar": {
          "type": "file",
          "max_select": 1
        }
      },
      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__verify_against_migration",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__verify_against_migration",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL__verify_against_migration",
        "updateRule": "UNRESOLVED__NEEDS_EXTERNAL__verify_against_migration",
        "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL__verify_against_migration"
      },
      "field_protection_requirements": {
        "role": "Must not be settable by ordinary user on self or others",
        "phone_verified": "Must not be settable by any user role via API",
        "is_alias_account": "Must not be settable by any user role via API"
      }
    },
    "children": {
      "type": "base",
      "description": "Child records linked to a parent user",
      "key_fields": {
        "parent": {
          "type": "relation",
          "collection": "users",
          "max_select": 1,
          "cascade_delete": true,
          "required": true
        },
        "name": {
          "type": "text",
          "required": true
        },
        "has_newborn_content": {
          "type": "bool"
        }
      },
      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.id != '' && @request.body.parent = @request.auth.id",
        "updateRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id",
        "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id"
      }
