  "collections": [
    {
      "name": "users",
      "type": "auth",
      "required_fields": [
        {"name": "name",                    "type": "text"},
        {"name": "phone",                   "type": "text",   "note": "protected — no direct write by user"},
        {"name": "phone_verified",          "type": "bool",   "note": "protected — set only by server"},
        {"name": "role",                    "type": "select", "values": ["user","admin","superadmin"], "note": "protected"},
        {"name": "is_alias_account",        "type": "bool",   "note": "protected"},
        {"name": "language_selected",       "type": "select", "values": ["ms","en","zh"]},
        {"name": "welcome_completed",       "type": "bool"},
        {"name": "recovery_email_prompted", "type": "bool"}
      ],
      "baseline_rules": {
        "listRule":   "role = 'superadmin' || role = 'admin'",
        "viewRule":   "@request.auth.id = id || role = 'superadmin' || role = 'admin'",
        "createRule": "@request.auth.id = '' && @request.body.role:isset = false && @request.body.is_alias_account:isset = false && @request.body.phone:isset = false",
        "updateRule": "@request.auth.id = id && @request.body.role:isset = false && @request.body.is_alias_account:isset = false && @request.body.phone:isset = false && @request.body.phone_verified:isset = false",
        "deleteRule": "role = 'superadmin'"
      },
      "note": "Recovery email field and endpoint blocked pending T-EMAIL-LIFECYCLE"
    },
