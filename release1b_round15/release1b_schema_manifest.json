        "administered_at": { "type": "date" }
      },
      "access_rules": { "listRule": "UNRESOLVED__NEEDS_EXTERNAL", "viewRule": "UNRESOLVED__NEEDS_EXTERNAL", "createRule": "UNRESOLVED__NEEDS_EXTERNAL", "updateRule": "UNRESOLVED__NEEDS_EXTERNAL", "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL" }
    },
    "progress_notes": {
      "type": "base",
      "key_fields": {
        "child": { "type": "relation", "collection": "children", "max_select": 1, "cascade_delete": true, "required": true },
        "note_text": { "type": "editor" },
        "attachment": { "type": "file", "max_select": 1, "protected": true }
