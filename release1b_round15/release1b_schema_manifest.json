      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: user = @request.auth.id",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: user = @request.auth.id",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL", "updateRule": "UNRESOLVED__NEEDS_EXTERNAL", "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL"
      }
    },
    "notifications": {
      "type": "base",
