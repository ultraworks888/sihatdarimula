        "message": { "type": "text", "required": true },
        "read": { "type": "bool" }
      },
      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: user = @request.auth.id",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: user = @request.auth.id",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: null",
        "updateRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: user = @request.auth.id",
        "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL"
