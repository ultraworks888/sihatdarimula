        "course": { "type": "relation", "collection": "courses", "max_select": 1, "required": true },
        "enrolled_at": { "type": "date" }
      },
      "access_rules": { "listRule": "UNRESOLVED__NEEDS_EXTERNAL", "viewRule": "UNRESOLVED__NEEDS_EXTERNAL", "createRule": "UNRESOLVED__NEEDS_EXTERNAL", "updateRule": "UNRESOLVED__NEEDS_EXTERNAL", "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL" }
    },
    "courses": {
      "type": "base",
      "key_fields": {
        "title": { "type": "text", "required": true },
        "has_newborn_content": { "type": "bool" }
      },
      "access_rules": { "listRule": "UNRESOLVED__NEEDS_EXTERNAL", "viewRule": "UNRESOLVED__NEEDS_EXTERNAL", "createRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: null or admin-only", "updateRule": "UNRESOLVED__NEEDS_EXTERNAL", "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL" }
    }
  },
  "unresolved_items": {
    "all_rule_values": "All access rule expressions are UNRESOLVED — must be verified against actual migration JS files",
    "email_verification_rule": "Whether authRule = 'verified = true' is set on users collection is UNRESOLVED",
    "articles_type_values": "Exact select values for articles.type are UNRESOLVED — antenatal/postnatal/general assumed"
  }
