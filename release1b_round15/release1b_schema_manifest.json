        "content": { "type": "editor" }
      },
      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.id != ''",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.id != ''",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.role = 'admin'",
        "updateRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.role = 'admin'",
        "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.role = 'admin'"
      }
    },
    "bookmarks": {
      "type": "base",
      "key_fields": {
