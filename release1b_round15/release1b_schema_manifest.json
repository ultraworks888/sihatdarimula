      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: child.parent = @request.auth.id",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: child.parent = @request.auth.id",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL",
