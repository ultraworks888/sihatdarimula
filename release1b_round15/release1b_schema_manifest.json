{
  "manifest_version": "1",
  "round": "15",
  "status": "DRAFTED",
  "basis": "Identical to R14 release1b_schema_manifest.json — no schema changes in R15",
  "description": "Schema manifest for Release 1B. All rule expressions marked UNRESOLVED must be verified against actual migration JS files before --run.",
  "collections": {
    "users": {
      "type": "auth",
      "key_fields": {
        "role": { "type": "select", "values": ["user", "admin", "superadmin"], "max_select": 1, "required": true, "default": "user" },
        "name": { "type": "text" },
        "language": { "type": "text" },
        "phone_verified": { "type": "bool", "note": "Historical flag; set server-side only" },
        "is_alias_account": { "type": "bool", "note": "Alias accounts must return 400 on auth (same as wrong-password)" },
        "avatar": { "type": "file", "max_select": 1 }
      },
      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL",
        "updateRule": "UNRESOLVED__NEEDS_EXTERNAL",
        "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL"
      },
      "field_protection_requirements": {
        "role": "Must not be settable by ordinary user on self or others",
        "phone_verified": "Must not be settable by any user role via API",
        "is_alias_account": "Must not be settable by any user role via API"
      }
    },
    "children": {
      "type": "base",
      "key_fields": {
        "parent": { "type": "relation", "collection": "users", "max_select": 1, "cascade_delete": true, "required": true },
        "name": { "type": "text", "required": true },
        "has_newborn_content": { "type": "bool" }
      },
      "access_rules": {
        "listRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id",
        "viewRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id",
        "createRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: @request.auth.id != '' && @request.body.parent = @request.auth.id",
        "updateRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id",
        "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL__expected: parent = @request.auth.id"
      }
    },
    "growth_records": {
      "type": "base",
      "key_fields": {
        "child": { "type": "relation", "collection": "children", "max_select": 1, "cascade_delete": true, "required": true },
        "weight_kg": { "type": "number" },
        "height_cm": { "type": "number" }
      },
      "access_rules": { "listRule": "UNRESOLVED__NEEDS_EXTERNAL", "viewRule": "UNRESOLVED__NEEDS_EXTERNAL", "createRule": "UNRESOLVED__NEEDS_EXTERNAL", "updateRule": "UNRESOLVED__NEEDS_EXTERNAL", "deleteRule": "UNRESOLVED__NEEDS_EXTERNAL" }
